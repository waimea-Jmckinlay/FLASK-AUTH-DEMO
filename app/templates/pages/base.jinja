{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="light">

<head>


	<title>Creatures {% block title %}{% endblock %}</title>



    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>

    <header>
 

        <h1>Messages</h1>

        <span class="greeting">
            {% if session.logged_in %}
                Welcome, <strong>{{ session.user.forename }}</strong>!
            {% else %}
                Welcome, guest!
            {% endif %}
        </span>

        <nav>
            <a href="/messages">Messages</a>

            {% if session.logged_in %}
                <a href="/message/new">Post a Message</a>
                <a href="/logout">Logout</a>
            {% else %}
                <a href="/login">Login</a>
                <a href="/user/new">Sign-Up</a>
            {% endif %}
        </nav>
    </header>

    {# Show flash messages from any previous events #}
    {% include "partials/messages.jinja" %}

    <main>

        {% block content %}
        {% endblock %}

    </main>

    <script>
        lucide.createIcons();
    </script>

</body>

</html>